<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- フラットグレーテーマ（明色・無彩色）: シャドウなし・グラデーションなし -->
    <Color x:Key="BackgroundColor">#ECECEE</Color>
    <Color x:Key="SurfaceColor">#F9F9FA</Color>
    <Color x:Key="SurfaceAltColor">#F1F1F3</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#52525B</Color>
    <Color x:Key="PrimaryLightColor">#E4E4E7</Color>
    <Color x:Key="PrimaryDarkColor">#3F3F46</Color>
    <Color x:Key="AccentColor">#EF4444</Color>
    <Color x:Key="AccentLightColor">#FEF2F2</Color>
    <Color x:Key="TextPrimaryColor">#1F1F23</Color>
    <Color x:Key="TextSecondaryColor">#3F3F46</Color>
    <Color x:Key="TextMutedColor">#8E8E96</Color>
    <Color x:Key="BorderColor">#D6D6DA</Color>
    <Color x:Key="BorderLightColor">#E7E7E9</Color>
    <Color x:Key="HoverColor">#E9E9EC</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="TabActiveColor">#F9F9FA</Color>
    <Color x:Key="TabInactiveColor">#ECECEE</Color>
    <Color x:Key="LogBackgroundColor">#F1F1F3</Color>
    <Color x:Key="LogTextColor">#3F3F46</Color>
    <Color x:Key="SidebarColor">#DFDFE2</Color>
    <Color x:Key="SidebarTextColor">#55555C</Color>
    <Color x:Key="SidebarActiveColor">#3F3F46</Color>
    <Color x:Key="SidebarHoverColor">#D3D3D7</Color>
    <Color x:Key="SidebarBorderColor">#CFCFD3</Color>
    <Color x:Key="SidebarSectionColor">#8E8E96</Color>
    <Color x:Key="SidebarVersionColor">#8E8E96</Color>
    <Color x:Key="SidebarStatusBgColor">#D6D6DA</Color>
    <Color x:Key="SidebarActiveTextColor">#1F1F23</Color>
    <Color x:Key="SidebarTitleColor">#1F1F23</Color>
    <Color x:Key="TextOnColorColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush"      Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"         Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"    Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"     Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"     Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"     Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="HoverBrush"           Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"         Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"         Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush"           Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="TabActiveBrush"       Color="{StaticResource TabActiveColor}"/>
    <SolidColorBrush x:Key="TabInactiveBrush"     Color="{StaticResource TabInactiveColor}"/>
    <SolidColorBrush x:Key="LogBackgroundBrush"   Color="{StaticResource LogBackgroundColor}"/>
    <SolidColorBrush x:Key="LogTextBrush"         Color="{StaticResource LogTextColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"           Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"       Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"     Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"     Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="SidebarSectionBrush"    Color="{StaticResource SidebarSectionColor}"/>
    <SolidColorBrush x:Key="SidebarVersionBrush"    Color="{StaticResource SidebarVersionColor}"/>
    <SolidColorBrush x:Key="SidebarStatusBgBrush"   Color="{StaticResource SidebarStatusBgColor}"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="{StaticResource SidebarActiveTextColor}"/>
    <SolidColorBrush x:Key="SidebarTitleBrush"      Color="{StaticResource SidebarTitleColor}"/>
    <SolidColorBrush x:Key="TextOnColorBrush"       Color="{StaticResource TextOnColorColor}"/>

    <!-- 種別トグル -->
    <!-- 種別ピル（LatestTitle 表示） -->
    <SolidColorBrush x:Key="KindPillVideoBgBrush"     Color="#1a6fbf"/>
    <SolidColorBrush x:Key="KindPillVideoFgBrush"     Color="#e6f1fb"/>
    <SolidColorBrush x:Key="KindPillShortBgBrush"     Color="#b85c0d"/>
    <SolidColorBrush x:Key="KindPillShortFgBrush"     Color="#faeeda"/>
    <SolidColorBrush x:Key="KindPillLiveBgBrush"      Color="#9b1c1c"/>
    <SolidColorBrush x:Key="KindPillLiveFgBrush"      Color="#fcebeb"/>
    <SolidColorBrush x:Key="KindPillPremiereBgBrush"  Color="#4f3aa0"/>
    <SolidColorBrush x:Key="KindPillPremiereFgBrush"  Color="#eeedfe"/>
    <SolidColorBrush x:Key="ShortBrush"        Color="#F97316"/>

    <!-- ウィンドウ閉じるボタンホバー -->
    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#C42B1C"/>

    <!-- クォータバー -->
    <SolidColorBrush x:Key="QuotaWarnHighBrush" Color="#FF3C00"/>
    <SolidColorBrush x:Key="QuotaWarnLowBrush"  Color="#FFD700"/>
    <SolidColorBrush x:Key="QuotaOkBrush"       Color="#22C55E"/>
    <SolidColorBrush x:Key="QuotaActualNormalBrush"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="QuotaActualPendingBrush"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="QuotaActualLiveStatusBrush" Color="#D946EF"/>
    <SolidColorBrush x:Key="QuotaEstimateNormalBrush"  Color="#3B82F6"/>
    <SolidColorBrush x:Key="QuotaEstimateLowFreqBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="QuotaEstimateFocusBrush"   Color="#22C55E"/>

    <!-- 動作ログ：レベル別バッジ色（テーマ非依存の固定色） -->
    <SolidColorBrush x:Key="LogLevelSystemBrush"  Color="#60A5FA"/>
    <SolidColorBrush x:Key="LogLevelInfoBrush"    Color="#94A3B8"/>
    <SolidColorBrush x:Key="LogLevelWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="LogLevelErrorBrush"   Color="#EF4444"/>
    <SolidColorBrush x:Key="LogLevelDebugBrush"   Color="#6B7280"/>

</ResourceDictionary>
