<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- フラットマットブラックテーマ（無彩色ダーク・差し色アンバー） -->
    <Color x:Key="BackgroundColor">#232323</Color>
    <Color x:Key="SurfaceColor">#2E2E2E</Color>
    <Color x:Key="SurfaceAltColor">#292929</Color>
    <Color x:Key="SurfaceElevatedColor">#383838</Color>
    <Color x:Key="PrimaryColor">#F0A83C</Color>
    <Color x:Key="PrimaryLightColor">#3A2E1A</Color>
    <Color x:Key="PrimaryDarkColor">#D8912A</Color>
    <Color x:Key="AccentColor">#EF4444</Color>
    <Color x:Key="AccentLightColor">#450A0A</Color>
    <Color x:Key="TextPrimaryColor">#D8D8D8</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
    <Color x:Key="TextMutedColor">#6E6E6E</Color>
    <Color x:Key="BorderColor">#3A3A3A</Color>
    <Color x:Key="BorderLightColor">#2E2E2E</Color>
    <Color x:Key="HoverColor">#333333</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="TabActiveColor">#2E2E2E</Color>
    <Color x:Key="TabInactiveColor">#232323</Color>
    <Color x:Key="LogBackgroundColor">#1C1C1C</Color>
    <Color x:Key="LogTextColor">#8C8C8C</Color>
    <Color x:Key="SidebarColor">#1A1A1A</Color>
    <Color x:Key="SidebarTextColor">#8C8C8C</Color>
    <Color x:Key="SidebarActiveColor">#F0A83C</Color>
    <Color x:Key="SidebarHoverColor">#2A2A2A</Color>
    <Color x:Key="SidebarBorderColor">#2E2E2E</Color>
    <Color x:Key="SidebarSectionColor">#5F5F5F</Color>
    <Color x:Key="SidebarVersionColor">#5F5F5F</Color>
    <Color x:Key="SidebarStatusBgColor">#2A2A2A</Color>
    <Color x:Key="SidebarActiveTextColor">#F0F0F0</Color>
    <Color x:Key="SidebarTitleColor">#F0F0F0</Color>
    <Color x:Key="TextOnColorColor">#1A1A1A</Color>

    <SolidColorBrush x:Key="BackgroundBrush"      Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"         Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"    Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"     Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"     Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"     Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="HoverBrush"           Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"         Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"         Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush"           Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="TabActiveBrush"       Color="{StaticResource TabActiveColor}"/>
    <SolidColorBrush x:Key="TabInactiveBrush"     Color="{StaticResource TabInactiveColor}"/>
    <SolidColorBrush x:Key="LogBackgroundBrush"   Color="{StaticResource LogBackgroundColor}"/>
    <SolidColorBrush x:Key="LogTextBrush"         Color="{StaticResource LogTextColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"           Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"       Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"     Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"     Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="SidebarSectionBrush"    Color="{StaticResource SidebarSectionColor}"/>
    <SolidColorBrush x:Key="SidebarVersionBrush"    Color="{StaticResource SidebarVersionColor}"/>
    <SolidColorBrush x:Key="SidebarStatusBgBrush"   Color="{StaticResource SidebarStatusBgColor}"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="{StaticResource SidebarActiveTextColor}"/>
    <SolidColorBrush x:Key="SidebarTitleBrush"      Color="{StaticResource SidebarTitleColor}"/>
    <SolidColorBrush x:Key="TextOnColorBrush"       Color="{StaticResource TextOnColorColor}"/>

    <!-- 種別トグル -->
    <!-- 種別ピル（LatestTitle 表示） -->
    <SolidColorBrush x:Key="KindPillVideoBgBrush"     Color="#185FA5"/>
    <SolidColorBrush x:Key="KindPillVideoFgBrush"     Color="#B5D4F4"/>
    <SolidColorBrush x:Key="KindPillShortBgBrush"     Color="#854F0B"/>
    <SolidColorBrush x:Key="KindPillShortFgBrush"     Color="#FAC775"/>
    <SolidColorBrush x:Key="KindPillLiveBgBrush"      Color="#791F1F"/>
    <SolidColorBrush x:Key="KindPillLiveFgBrush"      Color="#F7C1C1"/>
    <SolidColorBrush x:Key="KindPillPremiereBgBrush"  Color="#3C3489"/>
    <SolidColorBrush x:Key="KindPillPremiereFgBrush"  Color="#CECBF6"/>
    <SolidColorBrush x:Key="ShortBrush"        Color="#F97316"/>

    <!-- ウィンドウ閉じるボタンホバー -->
    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#C42B1C"/>

    <!-- クォータバー -->
    <SolidColorBrush x:Key="QuotaWarnHighBrush" Color="#FF3C00"/>
    <SolidColorBrush x:Key="QuotaWarnLowBrush"  Color="#FFD700"/>
    <SolidColorBrush x:Key="QuotaOkBrush"       Color="#22C55E"/>
    <SolidColorBrush x:Key="QuotaActualNormalBrush"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="QuotaActualPendingBrush"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="QuotaActualLiveStatusBrush" Color="#D946EF"/>
    <SolidColorBrush x:Key="QuotaEstimateNormalBrush"  Color="#3B82F6"/>
    <SolidColorBrush x:Key="QuotaEstimateLowFreqBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="QuotaEstimateFocusBrush"   Color="#22C55E"/>

    <!-- 動作ログ：レベル別バッジ色（テーマ非依存の固定色） -->
    <SolidColorBrush x:Key="LogLevelSystemBrush"  Color="#60A5FA"/>
    <SolidColorBrush x:Key="LogLevelInfoBrush"    Color="#94A3B8"/>
    <SolidColorBrush x:Key="LogLevelWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="LogLevelErrorBrush"   Color="#EF4444"/>
    <SolidColorBrush x:Key="LogLevelDebugBrush"   Color="#6B7280"/>

</ResourceDictionary>
