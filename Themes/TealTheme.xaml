<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- フラットティールテーマ（明色・青緑基調）: シャドウなし・グラデーションなし -->
    <Color x:Key="BackgroundColor">#D3EDEC</Color>
    <Color x:Key="SurfaceColor">#E9F7F6</Color>
    <Color x:Key="SurfaceAltColor">#E0F2F1</Color>
    <Color x:Key="SurfaceElevatedColor">#F3FBFA</Color>
    <Color x:Key="PrimaryColor">#0F8C87</Color>
    <Color x:Key="PrimaryLightColor">#D3F0EE</Color>
    <Color x:Key="PrimaryDarkColor">#0C736F</Color>
    <Color x:Key="AccentColor">#EF4444</Color>
    <Color x:Key="AccentLightColor">#FEF2F2</Color>
    <Color x:Key="TextPrimaryColor">#123634</Color>
    <Color x:Key="TextSecondaryColor">#2D5C58</Color>
    <Color x:Key="TextMutedColor">#6C948F</Color>
    <Color x:Key="BorderColor">#B9E1DE</Color>
    <Color x:Key="BorderLightColor">#D2ECEA</Color>
    <Color x:Key="HoverColor">#D3F0EE</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="TabActiveColor">#E9F7F6</Color>
    <Color x:Key="TabInactiveColor">#D3EDEC</Color>
    <Color x:Key="LogBackgroundColor">#E0F2F1</Color>
    <Color x:Key="LogTextColor">#2D5C58</Color>
    <Color x:Key="SidebarColor">#C0E4E1</Color>
    <Color x:Key="SidebarTextColor">#2D5C58</Color>
    <Color x:Key="SidebarActiveColor">#0F8C87</Color>
    <Color x:Key="SidebarHoverColor">#AAD9D5</Color>
    <Color x:Key="SidebarBorderColor">#A0D2CD</Color>
    <Color x:Key="SidebarSectionColor">#6C948F</Color>
    <Color x:Key="SidebarVersionColor">#6C948F</Color>
    <Color x:Key="SidebarStatusBgColor">#B9E1DE</Color>
    <Color x:Key="SidebarActiveTextColor">#123634</Color>
    <Color x:Key="SidebarTitleColor">#123634</Color>
    <Color x:Key="TextOnColorColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush"      Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"         Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"    Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"     Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"     Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"     Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="HoverBrush"           Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"         Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"         Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush"           Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="TabActiveBrush"       Color="{StaticResource TabActiveColor}"/>
    <SolidColorBrush x:Key="TabInactiveBrush"     Color="{StaticResource TabInactiveColor}"/>
    <SolidColorBrush x:Key="LogBackgroundBrush"   Color="{StaticResource LogBackgroundColor}"/>
    <SolidColorBrush x:Key="LogTextBrush"         Color="{StaticResource LogTextColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"           Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"       Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"     Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="{StaticResource SidebarHoverColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"     Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="SidebarSectionBrush"    Color="{StaticResource SidebarSectionColor}"/>
    <SolidColorBrush x:Key="SidebarVersionBrush"    Color="{StaticResource SidebarVersionColor}"/>
    <SolidColorBrush x:Key="SidebarStatusBgBrush"   Color="{StaticResource SidebarStatusBgColor}"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush" Color="{StaticResource SidebarActiveTextColor}"/>
    <SolidColorBrush x:Key="SidebarTitleBrush"      Color="{StaticResource SidebarTitleColor}"/>
    <SolidColorBrush x:Key="TextOnColorBrush"       Color="{StaticResource TextOnColorColor}"/>

    <!-- 種別トグル -->
    <!-- 種別ピル（LatestTitle 表示） -->
    <SolidColorBrush x:Key="KindPillVideoBgBrush"     Color="#1a6fbf"/>
    <SolidColorBrush x:Key="KindPillVideoFgBrush"     Color="#e6f1fb"/>
    <SolidColorBrush x:Key="KindPillShortBgBrush"     Color="#b85c0d"/>
    <SolidColorBrush x:Key="KindPillShortFgBrush"     Color="#faeeda"/>
    <SolidColorBrush x:Key="KindPillLiveBgBrush"      Color="#9b1c1c"/>
    <SolidColorBrush x:Key="KindPillLiveFgBrush"      Color="#fcebeb"/>
    <SolidColorBrush x:Key="KindPillPremiereBgBrush"  Color="#4f3aa0"/>
    <SolidColorBrush x:Key="KindPillPremiereFgBrush"  Color="#eeedfe"/>
    <SolidColorBrush x:Key="ShortBrush"        Color="#F97316"/>

    <!-- ウィンドウ閉じるボタンホバー -->
    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#C42B1C"/>

    <!-- クォータバー -->
    <SolidColorBrush x:Key="QuotaWarnHighBrush" Color="#FF3C00"/>
    <SolidColorBrush x:Key="QuotaWarnLowBrush"  Color="#FFD700"/>
    <SolidColorBrush x:Key="QuotaOkBrush"       Color="#22C55E"/>
    <SolidColorBrush x:Key="QuotaActualNormalBrush"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="QuotaActualPendingBrush"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="QuotaActualLiveStatusBrush" Color="#D946EF"/>
    <SolidColorBrush x:Key="QuotaEstimateNormalBrush"  Color="#3B82F6"/>
    <SolidColorBrush x:Key="QuotaEstimateLowFreqBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="QuotaEstimateFocusBrush"   Color="#22C55E"/>

    <!-- 動作ログ：レベル別バッジ色（テーマ非依存の固定色） -->
    <SolidColorBrush x:Key="LogLevelSystemBrush"  Color="#60A5FA"/>
    <SolidColorBrush x:Key="LogLevelInfoBrush"    Color="#94A3B8"/>
    <SolidColorBrush x:Key="LogLevelWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="LogLevelErrorBrush"   Color="#EF4444"/>
    <SolidColorBrush x:Key="LogLevelDebugBrush"   Color="#6B7280"/>

    <!-- チャンネルBAN／自主削除：アイコン塗りつぶし（テーマ非依存の固定色） -->
    <SolidColorBrush x:Key="ChannelUnavailableIconBrush" Color="#000000"/>

</ResourceDictionary>
