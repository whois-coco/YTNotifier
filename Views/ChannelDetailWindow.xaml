<Window x:Class="YTNotifier.Views.ChannelDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Width="380" MinWidth="380" MaxWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Noto Sans JP"
        KeyDown="ChannelDetailWindow_KeyDown">
    <Border CornerRadius="{StaticResource DialogCornerRadius}" BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Border.Background><DynamicResource ResourceKey="SurfaceBrush"/></Border.Background>
        <Border.BorderBrush><DynamicResource ResourceKey="BorderBrush"/></Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Border Grid.Row="0" Height="{StaticResource TitleBarHeight}" CornerRadius="{StaticResource DialogTitleBarCornerRadius}" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border.Background><DynamicResource ResourceKey="SidebarBrush"/></Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource TitleBarContentMargin}" VerticalAlignment="Center">
                        <Viewbox Style="{StaticResource TitleBarIconBox}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource TitleBarIconPath}" Data="M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="詳細設定" Style="{StaticResource TitleBarTitleText}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- コンテンツ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource SlimScrollViewer}">
                <StackPanel Margin="20,16,20,4">

                    <!-- チャンネル名 -->
                    <TextBlock x:Name="ChannelNameText" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>

                    <!-- カテゴリ -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="カテゴリ：" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CategoryText" Grid.Column="1"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 監視設定 -->
                    <Separator Style="{StaticResource HorizontalSeparator}" Margin="0,0,0,12"/>
                    <TextBlock Text="監視設定" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <!-- タブナビ -->
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0">
                                <StackPanel x:Name="FocusTabNav"
                                            Orientation="Horizontal"
                                            Height="36"/>
                            </Border>
                            <!-- タブコンテンツ -->
                            <StackPanel x:Name="FocusTabContent"
                                        Margin="14,12,14,12"/>
                        </StackPanel>
                    </Border>

                    <!-- API使用量 -->
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="API使用量(%)" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DetailQuotaBarBg" Grid.Column="0"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="4" Height="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border x:Name="DetailQuotaBarNormal"
                                                Height="10" Width="0" MinWidth="0"
                                                Background="{DynamicResource QuotaEstimateNormalBrush}"/>
                                        <Border x:Name="DetailQuotaBarLowFreq"
                                                Height="10" Width="0" MinWidth="0"
                                                Background="{DynamicResource QuotaEstimateLowFreqBrush}"/>
                                        <Border x:Name="DetailQuotaBarFocus"
                                                Height="10" Width="0" MinWidth="0"
                                                Background="{DynamicResource QuotaEstimateFocusBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="EstimateText" Grid.Column="1"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                            <!-- セグメントバー凡例 -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource QuotaEstimateNormalBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="通常" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource QuotaEstimateLowFreqBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="低頻度" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource QuotaEstimateFocusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="時間指定" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ボタン行 -->
            <Grid Grid.Row="2" Margin="20,8,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="キャンセル"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="保存"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
