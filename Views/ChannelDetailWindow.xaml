<Window x:Class="YTNotifier.Views.ChannelDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Width="380" MinWidth="380" MaxWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Noto Sans JP">
    <Border CornerRadius="8" BorderThickness="1">
        <Border.Background><DynamicResource ResourceKey="SurfaceBrush"/></Border.Background>
        <Border.BorderBrush><DynamicResource ResourceKey="BorderBrush"/></Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border.Background><DynamicResource ResourceKey="SidebarBrush"/></Border.Background>
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="詳細設定" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click"
                            FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>

            <!-- コンテンツ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource SlimScrollViewer}">
                <StackPanel Margin="20,16,20,4">

                    <!-- チャンネル名 -->
                    <TextBlock x:Name="ChannelNameText" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>

                    <!-- カテゴリ -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="カテゴリ：" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CategoryText" Grid.Column="1"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 待機所通知オプション -->
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="プレミア/ライブ通知方法"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="UpcomingNotifyModeCombo"
                                          Grid.Column="1" Width="160"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="UpcomingNotifyModeCombo_Changed">
                                    <ComboBoxItem Content="待機所のみ"       Tag="WaitingRoomOnly" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="開始時のみ"       Tag="LiveStartOnly"   Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="両方"             Tag="Both"            Style="{StaticResource ModernComboBoxItem}"/>
                                </ComboBox>
                            </Grid>
                            <Grid x:Name="UpcomingLeadRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="待機所通知タイミング"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="UpcomingLeadCombo"
                                          Grid.Column="1" Width="110"
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="5分前"  Tag="5"  Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="10分前" Tag="10" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="15分前" Tag="15" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="30分前" Tag="30" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="60分前" Tag="60" Style="{StaticResource ModernComboBoxItem}"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 監視設定 -->
                    <Separator Style="{StaticResource HorizontalSeparator}" Margin="0,0,0,12"/>
                    <TextBlock Text="監視設定" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <!-- タブナビ -->
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0">
                                <StackPanel x:Name="FocusTabNav"
                                            Orientation="Horizontal"
                                            Height="36"/>
                            </Border>
                            <!-- タブコンテンツ -->
                            <StackPanel x:Name="FocusTabContent"
                                        Margin="14,12,14,12"/>
                        </StackPanel>
                    </Border>

                    <!-- API使用量 -->
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="API使用量(%)" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DetailQuotaBarBg" Grid.Column="0"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="4" Height="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border x:Name="DetailQuotaBarNormal"
                                                Height="10" Width="0" MinWidth="0"
                                                Background="{DynamicResource PrimaryBrush}"/>
                                        <Border x:Name="DetailQuotaBarLowFreq"
                                                Height="10" Width="0" MinWidth="0"
                                                Background="{DynamicResource WarningBrush}"/>
                                        <Border x:Name="DetailQuotaBarFocus"
                                                Height="10" Width="0" MinWidth="0"
                                                Background="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="EstimateText" Grid.Column="1"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                            <!-- セグメントバー凡例 -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="通常" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="低頻度" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,8,0" VerticalAlignment="Center"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="時間指定" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ボタン行 -->
            <Grid Grid.Row="2" Margin="20,8,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="キャンセル"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="保存"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,8" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
