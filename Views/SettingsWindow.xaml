<Window x:Class="YTNotifier.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Width="616" Height="538"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Noto Sans JP"
        KeyDown="SettingsWindow_KeyDown">
    <Window.Resources>
        <!-- バックアップ／復元ボタンの共通幅（「💾 バックアップ」の描画幅 約99px ＋ Padding 24px ＋ 枠線 2px ＝ 125px に余白を加えた値） -->
        <sys:Double x:Key="BackupButtonWidth">130</sys:Double>

        <!-- ウィンドウ色ドロップダウンの色見本サイズ（1辺・角丸・ラベルとの間隔・枠線の太さ） -->
        <sys:Double x:Key="WindowColorSampleSize">16</sys:Double>
        <CornerRadius x:Key="WindowColorSampleCornerRadius">3</CornerRadius>
        <Thickness x:Key="WindowColorSampleLabelMargin">0,0,8,0</Thickness>
        <Thickness x:Key="WindowColorSampleBorderThickness">1</Thickness>

        <!-- カテゴリナビボタン（縦並び・選択中は左に色付きバー＋強調文字） -->
        <Style x:Key="CategoryNavItem" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderThickness="1">
        <Border.Background><DynamicResource ResourceKey="SurfaceBrush"/></Border.Background>
        <Border.BorderBrush><DynamicResource ResourceKey="BorderBrush"/></Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border.Background><DynamicResource ResourceKey="SidebarBrush"/></Border.Background>
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="設定" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click"
                            FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>

            <!-- コンテンツ：左カテゴリナビ＋右コンテンツエリア -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：カテゴリナビゲーション（縦） -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,0,8">
                    <StackPanel Margin="0,8">
                        <Border x:Name="CategoryNavBasic" Tag="Basic" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavBasicIcon" Text="⚙" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavBasicLabel" Text="基本設定" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CategoryNavDisplay" Tag="Display" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavDisplayIcon" Text="🎨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavDisplayLabel" Text="デザイン" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CategoryNavNotification" Tag="Notification" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavNotificationIcon" Text="🔔" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavNotificationLabel" Text="通知" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CategoryNavLog" Tag="Log" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavLogIcon" Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavLogLabel" Text="ログ" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CategoryNavData" Tag="Data" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavDataIcon" Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavDataLabel" Text="データ管理" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CategoryNavPlugins" Tag="Plugins" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavPluginsIcon" Text="🧩" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavPluginsLabel" Text="プラグイン" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CategoryNavAbout" Tag="About" Style="{StaticResource CategoryNavItem}"
                                MouseLeftButtonUp="CategoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryNavAboutIcon" Text="ℹ" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CategoryNavAboutLabel" Text="ABOUT" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

                <!-- 右：選択中カテゴリの内容 -->
                <Grid Grid.Column="2">

                    <!-- 1. 基本設定 -->
                    <ScrollViewer x:Name="CategoryPageBasic" Style="{StaticResource SlimScrollViewer}" Visibility="Visible"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <!-- APIキー -->
                            <TextBlock Text="APIキー" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ApiKeySlotComboBox" Grid.Column="0"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="ApiKeySlotComboBox_SelectionChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ApiKeyBox" Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True" TextAlignment="Center"
                                         FontSize="11"
                                         Padding="8,4"
                                         Margin="0,0,8,0"
                                         Background="{DynamicResource SurfaceAltBrush}"
                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                <Button x:Name="SaveApiKeyButton" Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="保存" Padding="12,5"
                                        FontSize="11"
                                        Click="SaveApiKey_Click"/>
                            </Grid>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,0">
                                <Hyperlink RequestNavigate="ApiKeyLink_Click"
                                           NavigateUri="https://console.developers.google.com">
                                    Google Cloud Console でAPIキーを取得 →
                                </Hyperlink>
                            </TextBlock>
                            <Separator Style="{StaticResource HorizontalSeparator}" Margin="0,12,0,8"/>

                            <!-- チェック間隔 -->
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="チェック間隔" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="IntervalComboBox" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="IntervalComboBox_SelectionChanged">
                                    <ComboBoxItem Content="3分"  Tag="3"  Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="5分"  Tag="5"  Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="10分" Tag="10" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="15分" Tag="15" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="20分" Tag="20" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="30分" Tag="30" Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="60分" Tag="60" Style="{StaticResource ModernComboBoxItem}"/>
                                </ComboBox>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="タスクトレイに格納" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="TrayToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="TrayToggle_Changed"
                                          Unchecked="TrayToggle_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="スタートアップ起動" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="StartupToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="StartupToggle_Changed"
                                          Unchecked="StartupToggle_Changed"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. 表示 -->
                    <ScrollViewer x:Name="CategoryPageDisplay" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ウィンドウ色" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="WindowColorComboBox" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="WindowColorComboBox_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="{StaticResource WindowColorSampleSize}" Height="{StaticResource WindowColorSampleSize}"
                                                        CornerRadius="{StaticResource WindowColorSampleCornerRadius}"
                                                        Margin="{StaticResource WindowColorSampleLabelMargin}"
                                                        BorderThickness="{StaticResource WindowColorSampleBorderThickness}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        Background="{Binding SampleBrush}"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="差し色" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="AccentColorSplitButton" Grid.Column="1"
                                        Height="36" CornerRadius="12" Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        MouseLeftButtonUp="AccentColorSplitButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="AccentColorCurrentSwatch" Grid.Column="0"
                                                Margin="6" CornerRadius="4"/>
                                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
                                        <TextBlock Grid.Column="2" Text="▾" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Popup x:Name="AccentColorPopup" Grid.Column="1"
                                       PlacementTarget="{Binding ElementName=AccentColorSplitButton}"
                                       Placement="Bottom" AllowsTransparency="True"
                                       StaysOpen="False" Focusable="False">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="8">
                                        <StackPanel>
                                            <UniformGrid x:Name="AccentColorGrid" Columns="5"/>
                                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                                            <Border x:Name="AccentColorResetRow" Cursor="Hand" Padding="6,4"
                                                    Background="Transparent"
                                                    MouseLeftButtonUp="AccentColorResetRow_Click">
                                                <TextBlock Text="既定に戻す" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="カテゴリなし表示" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="NoCategoryModeToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="NoCategoryModeToggle_Changed"
                                          Unchecked="NoCategoryModeToggle_Changed"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. 通知 -->
                    <ScrollViewer x:Name="CategoryPageNotification" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="デスクトップ通知" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="NotificationToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="NotificationToggle_Changed"
                                          Unchecked="NotificationToggle_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通知スタイル" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="ToastStyleComboBox" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="ToastStyleComboBox_Changed">
                                    <ComboBoxItem Content="デフォルト通知" Tag="Standard"
                                                  Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="サムネイル通知" Tag="Thumbnail"
                                                  Style="{StaticResource ModernComboBoxItem}"/>
                                </ComboBox>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通知音" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="NotificationSoundToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="NotificationSoundToggle_Changed"
                                          Unchecked="NotificationSoundToggle_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通知音の種類" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="NotificationSoundSetComboBox" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="NotificationSoundSetComboBox_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="タスクバー点滅" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="FlashTaskbarToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="FlashTaskbarToggle_Changed"
                                          Unchecked="FlashTaskbarToggle_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通知テスト" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Content="🔔 送信" Padding="14,7"
                                        VerticalAlignment="Center"
                                        Click="TestNotification_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 5. ログ -->
                    <ScrollViewer x:Name="CategoryPageLog" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="トレースログの取得" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="TraceLogToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="TraceLogToggle_Changed"
                                          Unchecked="TraceLogToggle_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ログ保持期間" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="LogRetentionComboBox" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="LogRetentionComboBox_Changed">
                                    <ComboBoxItem Content="0日（当日のみ）" Tag="0"  Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="1日"  Tag="1"   Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="3日"  Tag="3"   Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="5日"  Tag="5"   Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="7日"  Tag="7"   Style="{StaticResource ModernComboBoxItem}"/>
                                    <ComboBoxItem Content="無制限" Tag="-1" Style="{StaticResource ModernComboBoxItem}"/>
                                </ComboBox>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自動ログ削除" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoCleanLogsToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="AutoCleanLogsToggle_Changed"
                                          Unchecked="AutoCleanLogsToggle_Changed"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>

                            <TextBlock x:Name="LogCleanResultText" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,12,0,6" Text=""/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Content="🗑 ログ削除" Padding="14,7"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Click="CleanLogsNow_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                        Content="📋 ログ表示" Padding="14,7"
                                        VerticalAlignment="Center"
                                        Click="ShowActivityLog_Click"/>
                            </Grid>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="12,10">
                                <TextBlock x:Name="LogStatsText"
                                           Text="ログ情報を読み込み中..."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 6. データ管理 -->
                    <ScrollViewer x:Name="CategoryPageData" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <TextBlock Text="バックアップ" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="設定ファイルを書き出す" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Content="💾 バックアップ" Padding="12,6" Width="{StaticResource BackupButtonWidth}"
                                        Click="ExportBackup_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="バックアップから復元する" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Content="📂 復元" Padding="12,6" Width="{StaticResource BackupButtonWidth}"
                                        Click="ImportBackup_Click"/>
                            </Grid>
                            <TextBlock x:Name="BackupStatusText" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 7. プラグイン -->
                    <ScrollViewer x:Name="CategoryPagePlugins" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <TextBlock x:Name="PluginEmptyText" Text="プラグインは見つかりませんでした"
                                       FontSize="12" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="2,4,0,0"/>
                            <StackPanel x:Name="PluginListPanel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 8. ABOUT -->
                    <ScrollViewer x:Name="CategoryPageAbout" Style="{StaticResource SlimScrollViewer}" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="24,20">
                        <StackPanel>
                            <TextBlock Text="YTNotifier" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="AboutVersionText" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="ShowReleaseNotesBtn"
                                        Content="📋 リリースノート"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" FontSize="11"
                                        Margin="0,0,8,0"
                                        Click="ShowReleaseNotes_Click"/>
                                <Button x:Name="CheckForUpdateBtn"
                                        Content="🔄 更新確認"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" FontSize="11"
                                        Click="CheckForUpdateBtn_Click"/>
                            </StackPanel>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <TextBlock Text="YouTube新着動画通知アプリ" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="YouTube Data API v3 使用" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="AboutGeminiApiText" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Separator Style="{StaticResource HorizontalSeparator}"/>
                            <TextBlock Text="Created by Coco" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
