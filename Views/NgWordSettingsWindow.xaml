<Window x:Class="YTNotifier.Views.NgWordSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Width="760" Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Noto Sans JP">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="8" BorderThickness="1">
        <Border.Background><DynamicResource ResourceKey="SurfaceBrush"/></Border.Background>
        <Border.BorderBrush><DynamicResource ResourceKey="BorderBrush"/></Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border.Background><DynamicResource ResourceKey="SidebarBrush"/></Border.Background>
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚫" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="NGワード設定" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click"
                            FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>

            <!-- コンテンツ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上段：共通NGワード -->
                <StackPanel Grid.Row="0" Margin="20,16,20,12">
                    <TextBlock Text="共通NGワード" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="ここに追加した単語を含むタイトルの動画は、一覧には表示されますが通知はされません。"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <ItemsControl x:Name="CommonNgWordsItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="✕" Width="16" Height="16" Margin="6,0,0,0"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                Cursor="Hand" Tag="{Binding}" Click="RemoveCommonNgWord_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CommonNgWordInput" Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"
                                 KeyDown="CommonNgWordInput_KeyDown"/>
                        <Button Grid.Column="1" Content="追加" Style="{StaticResource SecondaryButton}"
                                Padding="16,8" Click="AddCommonNgWord_Click"/>
                    </Grid>
                </StackPanel>

                <Separator Grid.Row="1" Style="{StaticResource HorizontalSeparator}" Margin="20,0,20,12"/>

                <!-- 下段：チャンネル別NGワード（左右分割） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：チャンネル検索＋一覧 -->
                    <Grid Grid.Column="0" Margin="20,0,10,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="チャンネル別NGワード" Style="{StaticResource SectionHeader}"/>
                        <TextBox Grid.Row="1" x:Name="ChannelSearchBox" Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,8" ToolTip="チャンネル名で検索"
                                 TextChanged="ChannelSearchBox_TextChanged"/>
                        <ScrollViewer Grid.Row="2" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChannelListPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- 右：選択中チャンネルのNGワード -->
                    <Grid Grid.Column="2" Margin="10,0,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="ChannelNgPlaceholder"
                                       Text="チャンネルを選択してください"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel x:Name="ChannelNgPanel" Visibility="Collapsed">
                                <TextBlock x:Name="SelectedChannelNameText"
                                           FontSize="13" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ChannelNgWordsItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="✕" Width="16" Height="16" Margin="6,0,0,0"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                            Cursor="Hand" Tag="{Binding}" Click="RemoveChannelNgWord_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChannelNgWordInput" Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"
                                             KeyDown="ChannelNgWordInput_KeyDown"/>
                                    <Button Grid.Column="1" Content="追加" Style="{StaticResource SecondaryButton}"
                                            Padding="16,8" Click="AddChannelNgWord_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 参照用：現在の共通NGワード一覧 -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Separator Style="{StaticResource HorizontalSeparator}" Margin="0,0,0,8"/>
                            <TextBlock Text="現在の共通NGワード一覧（参照用）" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="CommonNgWordsRefItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
