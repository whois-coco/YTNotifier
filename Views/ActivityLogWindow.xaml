<Window x:Class="YTNotifier.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="動作ログ" Height="500" Width="600"
        MinHeight="300" MinWidth="600" MaxWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        FontFamily="Noto Sans JP"
        KeyDown="ActivityLogWindow_KeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource TitleBarContentMargin}" VerticalAlignment="Center">
                    <Viewbox Style="{StaticResource TitleBarIconBox}">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource TitleBarIconPath}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                            <Path Style="{StaticResource TitleBarIconPath}" Data="M14 2v4a2 2 0 0 0 2 2h4"/>
                            <Path Style="{StaticResource TitleBarIconPath}" Data="M16 13H8 M16 17H8 M10 9H8"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="動作ログ" Style="{StaticResource TitleBarTitleText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="LogFilterComboBox"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,8,0"
                              SelectionChanged="LogFilterComboBox_Changed">
                        <ComboBoxItem Content="情報"  Tag="Info"    Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="警告"  Tag="Warning" Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="エラー" Tag="Error"   Style="{StaticResource ModernComboBoxItem}"/>
                    </ComboBox>
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="SaveLogToFile_Click" Padding="{StaticResource OperationButtonPadding}" Margin="0,0,8,0"
                            Content="💾"
                            ToolTip="ファイルへ保存"
                            AutomationProperties.Name="ファイルへ保存"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="ClearLog_Click" Padding="{StaticResource OperationButtonPadding}" Margin="0,0,8,0"
                            Content="🗑"
                            ToolTip="クリア"
                            AutomationProperties.Name="クリア"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="OpenLogFolder_Click" Padding="{StaticResource OperationButtonPadding}"
                            Content="📁"
                            ToolTip="ログフォルダを開く"
                            AutomationProperties.Name="ログフォルダを開く"/>
                </StackPanel>
                <Button Grid.Column="2" Click="TitleBar_Close"
                        HorizontalAlignment="Right"
                        Width="46" Height="40"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Width="46" Height="40">
                                <TextBlock x:Name="CloseIcon" Text="✕"
                                           Foreground="{DynamicResource SidebarTextBrush}"
                                           FontSize="11" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                    <Setter TargetName="CloseIcon" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="1" Margin="16,12">
            <!-- ログ一覧 -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Border.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </Border.Resources>
                <ListBox x:Name="LogList"
                         Background="{DynamicResource LogBackgroundBrush}"
                         BorderThickness="0"
                         Padding="14"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FormattedTime, Mode=OneWay}"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Top"
                                           Margin="0,1,6,0"/>
                                <Border Grid.Column="1" CornerRadius="2"
                                        Padding="5,1" Margin="0,0,6,0"
                                        VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource LogLevelInfoBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="System">
                                                    <Setter Property="Background" Value="{DynamicResource LogLevelSystemBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource LogLevelWarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource LogLevelErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Debug">
                                                    <Setter Property="Background" Value="{DynamicResource LogLevelDebugBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LevelText, Mode=OneWay}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Text="{Binding ChannelNameFormatted, Mode=OneWay}"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource LogTextBrush}"
                                               Text="{Binding Message, Mode=OneWay}"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
