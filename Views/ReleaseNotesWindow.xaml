<Window x:Class="YTNotifier.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Width="700" Height="620"
        FontFamily="Noto Sans JP"
        KeyDown="ReleaseNotesWindow_KeyDown">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource DialogCornerRadius}"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Border Grid.Row="0" x:Name="TitleBar" Height="{StaticResource TitleBarHeight}" CornerRadius="{StaticResource DialogTitleBarCornerRadius}"
                    Background="{DynamicResource SidebarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource TitleBarContentMargin}" VerticalAlignment="Center">
                        <Viewbox Style="{StaticResource TitleBarIconBox}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource TitleBarIconPath}" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                                <Path Style="{StaticResource TitleBarIconPath}" Data="M14 2v4a2 2 0 0 0 2 2h4"/>
                                <Path Style="{StaticResource TitleBarIconPath}" Data="M12 11l1 2.5 2.5 1-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HeaderText" Style="{StaticResource TitleBarTitleText}"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <mdxam:MarkdownScrollViewer x:Name="NotesViewer" Grid.Row="1" Margin="20,16,20,20"
                                        ClickAction="OpenBrowser"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Background="{DynamicResource SurfaceBrush}">
                <mdxam:MarkdownScrollViewer.MarkdownStyle>
                    <Style TargetType="FlowDocument" BasedOn="{x:Static mdxam:MarkdownStyle.Sasabune}">
                        <Setter Property="FontFamily" Value="Noto Sans JP"/>
                    </Style>
                </mdxam:MarkdownScrollViewer.MarkdownStyle>
            </mdxam:MarkdownScrollViewer>
        </Grid>
    </Border>
</Window>
