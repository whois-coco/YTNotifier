<Window x:Class="YTNotifier.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Width="560" Height="620"
        FontFamily="Noto Sans JP">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Border Grid.Row="0" x:Name="TitleBar" Height="38" CornerRadius="6,6,0,0"
                    Background="{DynamicResource SidebarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="HeaderText" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarTextBrush}"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right"
                            Width="38" Height="38" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SidebarTextBrush}" Cursor="Hand"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <mdxam:MarkdownScrollViewer x:Name="NotesViewer" Grid.Row="1" Margin="20,16,20,20"
                                        ClickAction="OpenBrowser"/>
        </Grid>
    </Border>
</Window>
