<Window x:Class="YTNotifier.Views.AddChannelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="チャンネル追加"
        Width="520" Height="215"
        MinWidth="520" MinHeight="215"
        MaxWidth="520" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        FontFamily="Noto Sans JP"
        KeyDown="AddChannelWindow_KeyDown">

    <Window.Resources>
        <!-- ラベルを URL 入力欄の本文開始位置へ合わせるための左インセット。
             値 11 = ModernTextBox の Padding 左 10 + BorderThickness 1 -->
        <Thickness x:Key="FieldContentAlignedLabelMargin">11,0,0,4</Thickness>
        <!-- 連続追加モードチェックボックスの左インセット（値11の由来は上記と同じ）と、
             右側のステータステキストとの間隔（右12） -->
        <Thickness x:Key="ContinuousAddCheckBoxMargin">11,0,12,0</Thickness>
        <!-- プレースホルダーは実入力文字に合わせる。左24 = 本文開始位置11 + WPF TextBox 内部テキストインセット（実測で微調整した値） -->
        <Thickness x:Key="FieldContentAlignedPlaceholderMargin">24,0,50,0</Thickness>
        <!-- URL入力欄とペーストボタンを区切る仕切り線 -->
        <sys:Double x:Key="PasteDividerWidth">1</sys:Double>
        <sys:Double x:Key="PasteDividerHeight">20</sys:Double>
        <!-- 仕切り線の右位置 = ペーストボタン幅34 + 右余白3 + ボタンとの間隔5 -->
        <Thickness x:Key="PasteDividerMargin">0,0,42,0</Thickness>
        <!-- URL入力欄の本文右インセット。右50 = 仕切り線(右42)の手前で本文・キャレットが収まる位置 -->
        <Thickness x:Key="ChannelInputContentPadding">10,4,50,4</Thickness>
        <!-- チャンネルアイコンプレビューの一辺（円形クリップの半径 = この値 / 2）。
             左カラムの ColumnDefinition Width と一致させること -->
        <sys:Double x:Key="PreviewIconSize">68</sys:Double>
        <!-- 新規カテゴリ作成（＋）ボタンの枠。見た目をカテゴリのコンボボックス（ModernComboBox）に合わせる。
             一辺36 = コンボボックスの高さ36、角丸12・枠線1 = コンボボックスの枠と同じ -->
        <sys:Double x:Key="NewCategoryButtonFrameSize">36</sys:Double>
        <CornerRadius x:Key="NewCategoryButtonFrameCornerRadius">12</CornerRadius>
        <Thickness x:Key="NewCategoryButtonFrameThickness">1</Thickness>
        <!-- コンボボックスとの間隔（左4） -->
        <Thickness x:Key="NewCategoryButtonFrameMargin">4,0,0,0</Thickness>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource DialogCornerRadius}"
            Effect="{StaticResource DialogShadow}">
        <DockPanel>

            <!-- タイトルバー -->
            <Border DockPanel.Dock="Top" Height="{StaticResource TitleBarHeight}"
                    CornerRadius="{StaticResource DialogTitleBarCornerRadius}"
                    Background="{DynamicResource SidebarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="閉じる" AutomationProperties.Name="閉じる"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource TitleBarContentMargin}">
                        <Viewbox Style="{StaticResource TitleBarIconBox}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource TitleBarIconPath}" Data="M12 5v14 M5 12h14"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="チャンネル追加" Style="{StaticResource TitleBarTitleText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- メインコンテンツ -->
            <StackPanel Margin="12,10,12,12">

                <!-- 上段: プレビュー + 入力フォーム -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/><!-- = PreviewIconSize -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：プレビュー -->
                    <Border Grid.Column="0"
                            x:Name="PreviewIconBorder"
                            Width="{StaticResource PreviewIconSize}"
                            Height="{StaticResource PreviewIconSize}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <StackPanel x:Name="PreviewEmptyState"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="PreviewThumbnail"
                                   Visibility="Collapsed" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- 右：入力フォーム -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="チャンネルURL / ID / ハンドル"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="{StaticResource FieldContentAlignedLabelMargin}"/>
                        <Grid Grid.Row="1">
                            <TextBox x:Name="ChannelInputBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="{StaticResource ChannelInputContentPadding}"
                                     TextChanged="ChannelInputBox_TextChanged"/>
                            <TextBlock x:Name="ChannelInputPlaceholder"
                                       Text="https://youtube.com/... / @handle / UCxxxxxxx"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13" Margin="{StaticResource FieldContentAlignedPlaceholderMargin}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Border Width="{StaticResource PasteDividerWidth}"
                                    Height="{StaticResource PasteDividerHeight}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="{StaticResource PasteDividerMargin}"
                                    Background="{DynamicResource BorderBrush}"/>
                            <Button x:Name="PasteButton"
                                    Width="34" Height="34"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,3,0" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="PasteButton_Click" ToolTip="クリップボードから貼り付け">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                                Width="34" Height="34">
                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
                                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                                    <Path Data="M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z"
                                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- 連続追加チェックボックス + ステータステキスト + 検索／追加ボタン -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="ContinuousAddCheckBox"
                                      Content="連続追加モード"
                                      FontSize="11"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="{StaticResource ContinuousAddCheckBoxMargin}"
                                      Style="{StaticResource ModernCheckBox}"
                                      Checked="ContinuousAddCheckBox_Changed"
                                      Unchecked="ContinuousAddCheckBox_Changed"/>
                            <TextBlock x:Name="PreviewStatusText" Grid.Column="1"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <!-- 表示（検索／追加）はコード側で候補の有無に応じて切り替える -->
                            <Button Grid.Column="2" x:Name="SearchOrAddButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="検索" Padding="{StaticResource InlineButtonPadding}"
                                    Click="SearchOrAddButton_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 拡張エリア: チャンネル発見時に表示 -->
                <Border x:Name="ExpandedArea" Visibility="Collapsed"
                        Margin="0,12,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- カテゴリ選択（右列） -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="カテゴリ" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CategoryComboBox"
                                              Grid.Column="0"
                                              Style="{StaticResource ModernComboBox}"/>
                                    <!-- IconButton は枠線を描かないため、枠用の Border で囲む。
                                         中のボタンは枠いっぱいに広げ、ホバー背景を枠の内側に収める -->
                                    <Border Grid.Column="1"
                                            Width="{StaticResource NewCategoryButtonFrameSize}"
                                            Height="{StaticResource NewCategoryButtonFrameSize}"
                                            Margin="{StaticResource NewCategoryButtonFrameMargin}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="{StaticResource NewCategoryButtonFrameThickness}"
                                            CornerRadius="{StaticResource NewCategoryButtonFrameCornerRadius}">
                                        <Button x:Name="NewCategoryButton"
                                                Style="{StaticResource IconButton}"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                ToolTip="新しいカテゴリを作成"
                                                Click="NewCategoryButton_Click">
                                            <Viewbox Width="13" Height="13">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M12 5v14"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" Fill="Transparent"/>
                                                    <Path Data="M5 12h14"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" Fill="Transparent"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Border>
                                </Grid>
                                <!-- 新規カテゴリ入力エリア -->
                                <Grid x:Name="NewCategoryPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewCategoryInput"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"
                                             Padding="8,4"
                                             FontSize="12"
                                             MaxLength="40"
                                             KeyDown="NewCategoryInput_KeyDown"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Width="26" Height="26"
                                            Margin="4,0,0,0"
                                            Foreground="{DynamicResource SuccessBrush}"
                                            ToolTip="作成"
                                            Click="NewCategoryConfirm_Click">
                                        <Viewbox Width="13" Height="13">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M20 6 9 17l-5-5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2.5" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Width="26" Height="26"
                                            Margin="2,0,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            ToolTip="キャンセル"
                                            Click="NewCategoryCancel_Click">
                                        <Viewbox Width="11" Height="11">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M18 6 6 18"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Fill="Transparent"/>
                                                <Path Data="M6 6l12 12"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- チェック対象（左列） -->
                            <StackPanel x:Name="CheckTargetPanel" Grid.Column="0">
                                <TextBlock Text="チェック対象" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <StackPanel x:Name="KindToggleRow" Orientation="Horizontal" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 詳細設定 Expander -->
                        <Expander x:Name="DetailExpander"
                                  Margin="0,12,0,0"
                                  IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="詳細設定" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Expander.Header>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Margin="0,8,0,0">
                                <DockPanel>
                                    <!-- タブナビゲーション（固定） -->
                                    <Border DockPanel.Dock="Top"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,10,12,0">
                                        <StackPanel x:Name="DetailFocusTabNav"
                                                    Orientation="Horizontal" Height="30"/>
                                    </Border>
                                    <!-- タブコンテンツ（スクロール可能） -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="340"
                                                  Padding="12,10,12,12"
                                                  Style="{StaticResource SlimScrollViewer}">
                                        <StackPanel x:Name="DetailFocusTabContent"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>
