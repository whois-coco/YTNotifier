<Window x:Class="YTNotifier.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" MinWidth="320" MaxWidth="480"
        FontFamily="Noto Sans JP">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource DialogCornerRadius}"
            Effect="{StaticResource DialogShadow}">
        <StackPanel>
            <!-- タイトルバー -->
            <Border x:Name="TitleBar" Height="{StaticResource TitleBarHeight}" CornerRadius="{StaticResource DialogTitleBarCornerRadius}"
                    Background="{DynamicResource SidebarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="{StaticResource TitleBarContentMargin}" VerticalAlignment="Center">
                    <Viewbox Style="{StaticResource TitleBarIconBox}">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource TitleBarIconPath}" Data="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0"/>
                            <Path Style="{StaticResource TitleBarIconPath}" Data="M12 8v4 M12 16h.01"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleBarTitleText}"/>
                </StackPanel>
            </Border>

            <!-- メッセージ -->
            <TextBlock x:Name="MessageText" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Margin="20,16,20,0"/>

            <!-- ボタン行 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,16,20,16">
                <Button x:Name="CancelButton" Content="キャンセル"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="OK"
                        Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
