<Window x:Class="YTNotifier.Views.ApiKeySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTNotifier - 初回設定"
        Width="640" Height="680"
        MinWidth="640" MaxWidth="640"
        MinHeight="680" MaxHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Noto Sans JP">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource DialogCornerRadius}"
            Effect="{StaticResource DialogShadow}">
        <DockPanel>

            <!-- タイトルバー -->
            <Border DockPanel.Dock="Top" Height="{StaticResource TitleBarHeight}"
                    CornerRadius="{StaticResource DialogTitleBarCornerRadius}"
                    Background="{DynamicResource SidebarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="閉じる" AutomationProperties.Name="閉じる"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource TitleBarContentMargin}">
                        <Viewbox Style="{StaticResource TitleBarIconBox}">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource TitleBarIconPath}" Data="M2 15.5a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0 -11 0"/>
                                <Path Style="{StaticResource TitleBarIconPath}" Data="m21 2-9.6 9.6"/>
                                <Path Style="{StaticResource TitleBarIconPath}" Data="m15.5 7.5 3 3L22 7l-3-3"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="YouTube Data API v3 キーを設定" Style="{StaticResource TitleBarTitleText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- フッター（戻る/次へ・進捗表示） -->
            <Grid DockPanel.Dock="Bottom" Margin="20,12,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0"
                        Style="{StaticResource SecondaryButton}"
                        Content="戻る"
                        Click="BackButton_Click"/>
                <TextBlock x:Name="ProgressText" Grid.Column="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                <Button x:Name="NextButton" Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Content="次へ"
                        Click="NextButton_Click"/>
            </Grid>

            <!-- コンテンツ（ステップごとに切替） -->
            <Grid Margin="20,16,20,0">

                <!-- ステップ1：説明 -->
                <StackPanel x:Name="IntroPanel">
                    <TextBlock x:Name="IntroTitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock FontSize="13" TextWrapping="Wrap"
                               LineHeight="22" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="YTNotifierはYouTubeの新着動画・ライブ配信を監視するために、YouTube Data API v3という仕組みを利用しています。このAPIを利用するには「APIキー」と呼ばれる、いわば専用の合言葉のようなものが必要です。APIキーはお客様ご自身のGoogleアカウントで発行するもので、次の手順で無料で取得できます。"/>
                    <TextBlock Margin="0,12,0,0" FontSize="11">
                        <Hyperlink Click="SkipLink_Click">手順を省略してAPIキーを直接入力する →</Hyperlink>
                    </TextBlock>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="既に利用した事がありバックアップをお持ちの方は復元ボタンから復元を行って下さい。" FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="📂 復元" Padding="{StaticResource OperationButtonPadding}"
                                Click="RestoreButton_Click"/>
                    </Grid>
                </StackPanel>

                <!-- ステップ2〜19：手順画像 -->
                <StackPanel x:Name="StepImagePanel" Visibility="Collapsed">
                    <TextBlock x:Name="StepTitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <Border Width="560" Height="300" HorizontalAlignment="Center"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Image x:Name="StepImage" Stretch="Uniform"/>
                    </Border>
                    <Button x:Name="OpenConsoleButton" Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButton}"
                            Content="Google Cloud Consoleを開く" Padding="{StaticResource OperationButtonPadding}"
                            Click="OpenConsoleButton_Click"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="StepDescriptionText" Margin="0,12,0,0"
                               FontSize="13" TextWrapping="Wrap"
                               LineHeight="22" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- ステップ20：APIキー入力 -->
                <StackPanel x:Name="KeyInputPanel" Visibility="Collapsed">
                    <TextBlock x:Name="KeyInputTitleText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="取得したAPIキーを以下のAPIキー欄に入力してください。" FontSize="13" TextWrapping="Wrap"
                               LineHeight="22" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="APIキー" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ApiKeyBox" Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="10,4"
                                 Margin="0,0,8,0"
                                 KeyDown="ApiKeyBox_KeyDown"/>
                        <Button Grid.Column="1" x:Name="SaveButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="保存" Padding="{StaticResource InlineButtonPadding}"
                                Click="SaveButton_Click"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </DockPanel>
    </Border>
</Window>
